+  if (typeof saved.waterGoalOz === 'number') return null;
+  const next: ClientSettings = { ...DEFAULT_SETTINGS, ...saved, waterGoalOz: Math.round(goal) };
+  await AsyncStorage.setItem(SETTINGS_KEY, JSON.stringify(next));
+  return next;
