+export function formatHeight(cm: number, unit: 'imperial' | 'metric'): string {
+  if (unit === 'metric') return `${Math.round(cm)} cm`;
+  const inches = Math.round(cm / 2.54);
+  return `${Math.floor(inches / 12)} ft ${inches % 12} in`;
+}
