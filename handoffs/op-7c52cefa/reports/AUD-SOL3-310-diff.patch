+const WEEKS_WORDS: Record<number, string> = { 1: 'One', 2: 'Two', 3: 'Three', 4: 'Four', 5: 'Five', 6: 'Six', 8: 'Eight', 12: 'Twelve' };
+export function weeksEyebrow(weeks: number): string {
